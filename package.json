{
  "name": "face-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sites-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests",
    "vectorizer:setup": "npm --prefix tools/part-vectorizer-v2 install",
    "vectorize:parts": "npm --prefix tools/part-vectorizer-v2 run vectorize --"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "displayName": "Face Editor"
}
