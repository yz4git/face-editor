    "eye": {"minX": -0.19, "maxX": 0.19, "minY": -0.20, "maxY": 0.20, "flipY": true}
  },
  "kindRoleBaseColors": {
    "hair": {"hair": "#583c28", "hairTie": "#d34d56"},
    "eye": {"outline": "#281b18", "white": "#fffaf0", "eyes": "#80552f", "pupil": "#211714", "highlight": "#ffffff"}
  },
  "quality": {
    "minMaskIoU": 0.90,
    "minBoundaryF1": 0.82,
    "maxColorMae": 42,
    "maxTriangles": 600
  },
  "items": [
