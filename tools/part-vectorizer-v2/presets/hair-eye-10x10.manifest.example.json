{
  "schemaVersion": 2,
  "notes": "Example for a 1600x1200 authoring sheet with a 5x2 hair region above a 5x2 eye region. Measure x/y/width/height once for a new sheet layout, then reuse the manifest for every sheet generated with that layout.",
  "source": "./hair-eye-sheet.png",
  "output": "./vectorizer-output",
  "exportName": "AUTO_HAIR_EYE_VARIANTS",
  "concurrency": 4,
  "kindGrids": {
    "hair": {"columns": 5, "rows": 2, "x": 80, "y": 115, "width": 1440, "height": 480, "gapX": 0, "gapY": 0},
    "eye": {"columns": 5, "rows": 2, "x": 80, "y": 705, "width": 1440, "height": 320, "gapX": 0, "gapY": 0}
  },
  "kindInsets": {
    "hair": {"left": 0.04, "right": 0.04, "top": 0.04, "bottom": 0.04},
    "eye": {"left": 0.07, "right": 0.07, "top": 0.09, "bottom": 0.09}
  },
  "targetBoundsByKind": {
